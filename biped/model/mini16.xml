<!--
  Mini16 (GENERADO por cad/build_mjcf.py a partir del CAD: no editar a mano).

  Bípedo de 16 motores: 12 Feetech STS3215 en las piernas (cadera yaw/roll/pitch, rodilla,
  tobillo pitch y roll) y 4 Feetech SCS0009 en cuello/cabeza. Distancias entre ejes, mallas y
  masas salen de cad/lib/params.scad y de las piezas exportadas (PETG/TPU).

  Componentes: Orange Pi Zero 3, cámara USB, 2x 18650 + BMS 2S, IMU BNO055,
  ToF VL53L5CX/VL53L8CX, 4x SS-10 (pisada en punta y talón).

  Ejes: x = adelante, y = izquierda, z = arriba. Unidades: m, kg, rad.
  Origen del torso = punto medio entre los ejes de cadera pitch.
-->
<mujoco model="mini16">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <asset>
    <mesh name="left_yaw_link" file="../cad/stl/left_yaw_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_roll_link" file="../cad/stl/left_roll_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_thigh" file="../cad/stl/left_thigh.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_shin" file="../cad/stl/left_shin.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_ankle_cross" file="../cad/stl/left_ankle_cross.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_foot" file="../cad/stl/left_foot.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_sole" file="../cad/stl/left_sole.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_yaw_link" file="../cad/stl/right_yaw_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_roll_link" file="../cad/stl/right_roll_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_thigh" file="../cad/stl/right_thigh.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_shin" file="../cad/stl/right_shin.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_ankle_cross" file="../cad/stl/right_ankle_cross.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_foot" file="../cad/stl/right_foot.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_sole" file="../cad/stl/right_sole.stl" scale="0.001 0.001 0.001"/>
    <mesh name="servo" file="../cad/stl/servo.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <geom contype="2" conaffinity="1" friction="0.9 0.02 0.01" condim="3"/>
    <joint damping="0.08" armature="0.01" frictionloss="0.03"/>
    <!-- STS3215 7.4 V: ~1.9 N·m máx. Ganancias estimadas (identificar con servo real). -->
    <position kp="10" kv="0.15" forcerange="-1.9 1.9"/>
    <default class="micro">
      <!-- Feetech SCS0009: ~0.23 N·m a 6 V. Valores estimados. -->
      <joint damping="0.01" armature="0.001" frictionloss="0.005"/>
      <position kp="1.5" kv="0.02" forcerange="-0.22 0.22"/>
    </default>
    <default class="micro_servo">
      <geom type="box" size="0.012 0.011 0.006" mass="0.012" rgba="0.1 0.1 0.11 1"/>
    </default>
    <default class="petg">
      <geom rgba="0.55 0.82 0.9 1"/>
    </default>
    <default class="tpu">
      <geom rgba="0.2 0.2 0.22 1" friction="1.0 0.02 0.01" solref="0.015 1"/>
    </default>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 0.1200">
      <freejoint name="root"/>
      <!-- IMU BNO055 nivelada entre los servos de cadera -->
      <site name="imu" pos="0 0 0.0732" size="0.005"/>
      <geom name="imu_board" type="box" pos="0 0 0.0712" size="0.0105 0.013 0.001" mass="0.003" contype="0" conaffinity="0" rgba="0.1 0.3 0.6 1"/>
      <!-- Torso (PETG): servos yaw abajo, batería 2x18650 encima, Orange Pi Zero 3 arriba;
           atrás: adaptadores de bus, UBEC 5 V, regulador 6 V, BMS 2S y condensador. -->
      <geom name="torso" type="box" pos="-0.0026 0 0.0906" size="0.0366 0.0454 0.0368" mass="0.07" rgba="0.55 0.82 0.9 0.35"/>
      <geom name="battery" type="box" pos="-0.0026 0 0.1009" size="0.0325 0.0185 0.0095" mass="0.098" contype="0" conaffinity="0" rgba="0.2 0.3 0.6 1"/>
      <geom name="orange_pi" type="box" pos="-0.0026 0 0.1174" size="0.0275 0.025 0.006" mass="0.025" contype="0" conaffinity="0" rgba="0.95 0.5 0.1 1"/>
      <geom name="power_and_bus" type="box" pos="-0.0331 0 0.1034" size="0.004 0.035 0.012" mass="0.05" contype="0" conaffinity="0" rgba="0.1 0.5 0.2 1"/>
      <!-- Sensor ToF 8x8 (VL53L5CX / VL53L8CX) al frente, mirando 45° hacia el piso -->
      <geom name="tof_sensor" type="box" pos="0.0350 0 0.0658" size="0.001 0.0065 0.01" mass="0.002" contype="0" conaffinity="0" rgba="0.1 0.1 0.1 1"/>
      <site name="tof" pos="0.0370 0 0.0658" zaxis="0.7 0 -0.7" size="0.003"/>
      <geom name="left_hip_yaw_servo" type="mesh" mesh="servo" pos="0 0.03 0.0718131" xyaxes="-1 0 0 0 1 0" mass="0.055" rgba="0.12 0.12 0.13 1" contype="0" conaffinity="0"/>
      <geom name="right_hip_yaw_servo" type="mesh" mesh="servo" pos="0 -0.03 0.0718131" xyaxes="-1 -0 0 -0 1 -0" mass="0.055" rgba="0.12 0.12 0.13 1" contype="0" conaffinity="0"/>

      <body name="left_hip_yaw_link" pos="0 0.0300 0.05319">
        <joint name="left_hip_yaw" axis="0 0 1" range="-0.35 0.35"/>
        <geom name="left_yaw_link" type="mesh" mesh="left_yaw_link" mass="0.0069" class="petg"/>
        <body name="left_hip_roll_link" pos="0 0 -0.02497">
          <joint name="left_hip_roll" axis="1 0 0" range="-0.5 0.5"/>
          <geom name="left_roll_link" type="mesh" mesh="left_roll_link" mass="0.0144" class="petg"/>
          <geom name="left_hip_roll_servo" type="mesh" mesh="servo" pos="0 0 0" xyaxes="0 1 0 0 0 1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
          <geom name="left_hip_pitch_servo" type="mesh" mesh="servo" pos="0 0 -0.02822" xyaxes="1 0 0 0 0 -1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
          <body name="left_thigh" pos="0 0 -0.02822">
            <joint name="left_hip_pitch" axis="0 1 0" range="-0.29 1.29"/>
            <geom name="left_thigh" type="mesh" mesh="left_thigh" mass="0.0132" class="petg"/>
            <geom name="left_knee_servo" type="mesh" mesh="servo" pos="0 0 -0.0333281" xyaxes="-1 0 0 0 -0 1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
            <body name="left_shin" pos="0 0 -0.03333">
              <joint name="left_knee" axis="0 1 0" range="-1.45 0.1"/>
              <geom name="left_shin" type="mesh" mesh="left_shin" mass="0.0132" class="petg"/>
              <geom name="left_ankle_servo" type="mesh" mesh="servo" pos="0 0 -0.0333281" xyaxes="1 0 0 0 0 -1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
              <body name="left_ankle_link" pos="0 0 -0.03333">
                <joint name="left_ankle" axis="0 1 0" range="-0.19 1.4"/>
                <geom name="left_ankle_cross" type="mesh" mesh="left_ankle_cross" mass="0.0134" class="petg"/>
                <geom name="left_ankle_roll_servo" type="mesh" mesh="servo" pos="0 0 -0.0333281" xyaxes="0 1 0 0 0 1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
                <body name="left_foot" pos="0 0 -0.03333">
                  <joint name="left_ankle_roll" axis="1 0 0" range="-0.5 0.5"/>
                  <geom name="left_foot_plate" type="mesh" mesh="left_foot" mass="0.0192" class="petg"/>
                  <!-- Suela de TPU: es la que toca el piso (forma real, con bordes curvos) -->
                  <geom name="left_sole" type="mesh" mesh="left_sole" mass="0.0084" class="tpu"/>
                  <site name="left_toe_touch" type="box" pos="0.0370 0 -0.0325" size="0.012 0.022 0.004" rgba="0 0 0 0"/>
                  <site name="left_heel_touch" type="box" pos="-0.0270 0 -0.0325" size="0.012 0.022 0.004" rgba="0 0 0 0"/>
                  <site name="left_sole_bottom" pos="0 0 -0.0345" size="0.002"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body name="right_hip_yaw_link" pos="0 -0.0300 0.05319">
        <joint name="right_hip_yaw" axis="0 0 1" range="-0.35 0.35"/>
        <geom name="right_yaw_link" type="mesh" mesh="right_yaw_link" mass="0.0069" class="petg"/>
        <body name="right_hip_roll_link" pos="0 0 -0.02497">
          <joint name="right_hip_roll" axis="1 0 0" range="-0.5 0.5"/>
          <geom name="right_roll_link" type="mesh" mesh="right_roll_link" mass="0.0144" class="petg"/>
          <geom name="right_hip_roll_servo" type="mesh" mesh="servo" pos="0 -0 0" xyaxes="0 -1 0 0 0 -1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
          <geom name="right_hip_pitch_servo" type="mesh" mesh="servo" pos="0 -0 -0.02822" xyaxes="1 -0 0 0 0 1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
          <body name="right_thigh" pos="0 0 -0.02822">
            <joint name="right_hip_pitch" axis="0 1 0" range="-0.29 1.29"/>
            <geom name="right_thigh" type="mesh" mesh="right_thigh" mass="0.0132" class="petg"/>
            <geom name="right_knee_servo" type="mesh" mesh="servo" pos="0 -0 -0.0333281" xyaxes="-1 -0 0 0 -0 -1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
            <body name="right_shin" pos="0 0 -0.03333">
              <joint name="right_knee" axis="0 1 0" range="-1.45 0.1"/>
              <geom name="right_shin" type="mesh" mesh="right_shin" mass="0.0132" class="petg"/>
              <geom name="right_ankle_servo" type="mesh" mesh="servo" pos="0 -0 -0.0333281" xyaxes="1 -0 0 0 0 1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
              <body name="right_ankle_link" pos="0 0 -0.03333">
                <joint name="right_ankle" axis="0 1 0" range="-0.19 1.4"/>
                <geom name="right_ankle_cross" type="mesh" mesh="right_ankle_cross" mass="0.0134" class="petg"/>
                <geom name="right_ankle_roll_servo" type="mesh" mesh="servo" pos="0 -0 -0.0333281" xyaxes="0 -1 0 0 0 -1" mass="0.055" rgba="0.12 0.12 0.13 1"/>
                <body name="right_foot" pos="0 0 -0.03333">
                  <joint name="right_ankle_roll" axis="1 0 0" range="-0.5 0.5"/>
                  <geom name="right_foot_plate" type="mesh" mesh="right_foot" mass="0.0192" class="petg"/>
                  <!-- Suela de TPU: es la que toca el piso (forma real, con bordes curvos) -->
                  <geom name="right_sole" type="mesh" mesh="right_sole" mass="0.0084" class="tpu"/>
                  <site name="right_toe_touch" type="box" pos="0.0370 0 -0.0325" size="0.012 0.022 0.004" rgba="0 0 0 0"/>
                  <site name="right_heel_touch" type="box" pos="-0.0270 0 -0.0325" size="0.012 0.022 0.004" rgba="0 0 0 0"/>
                  <site name="right_sole_bottom" pos="0 0 -0.0345" size="0.002"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============================ CUELLO Y CABEZA ============================ -->
      <body name="neck" pos="0 0 0.1274" childclass="micro">
        <joint name="neck_pitch" axis="0 1 0" range="-0.8 0.8"/>
        <geom class="micro_servo"/>
        <geom name="neck" type="box" pos="0 0 0.004" size="0.009 0.012 0.004" mass="0.003" rgba="0.1 0.1 0.11 1"/>
        <body name="head_pitch_link" pos="0 0 0.008">
          <joint name="head_pitch" axis="0 1 0" range="-0.9 0.9"/>
          <geom class="micro_servo"/>
          <body name="head_yaw_link" pos="0 0 0.008">
            <joint name="head_yaw" axis="0 0 1" range="-1.3 1.3"/>
            <geom class="micro_servo" size="0.011 0.011 0.004"/>
            <body name="head" pos="0 0 0.008">
              <joint name="head_roll" axis="1 0 0" range="-0.5 0.5"/>
              <geom class="micro_servo" size="0.011 0.006 0.006"/>
              <geom name="head" type="box" pos="0.02 0 0.024" size="0.042 0.032 0.02" mass="0.04" rgba="0.55 0.82 0.9 1"/>
              <!-- Cámara USB compacta (placa 32 x 32 mm, ~6 g), ~70° de campo horizontal -->
              <geom name="camera_board" type="box" pos="0.0635 0 0.024" size="0.0015 0.016 0.016" mass="0.005"
                    contype="0" conaffinity="0" rgba="0.1 0.35 0.15 1"/>
              <geom name="camera_lens_mount" type="box" pos="0.0665 0 0.026" size="0.0015 0.0055 0.0055" mass="0.001"
                    contype="0" conaffinity="0" rgba="0.08 0.08 0.08 1"/>
              <geom name="camera_lens" type="cylinder" pos="0.069 0 0.026" zaxis="1 0 0" size="0.0038 0.001"
                    contype="0" conaffinity="0" density="0" rgba="0.15 0.2 0.5 1"/>
              <camera name="eye" pos="0.0705 0 0.026" xyaxes="0 -1 0 0 0 1" fovy="55"/>
              <site name="camera" pos="0.0705 0 0.026" size="0.003"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_hip_yaw" joint="left_hip_yaw" ctrlrange="-0.35 0.35"/>
    <position name="left_hip_roll" joint="left_hip_roll" ctrlrange="-0.5 0.5"/>
    <position name="left_hip_pitch" joint="left_hip_pitch" ctrlrange="-0.29 1.29"/>
    <position name="left_knee" joint="left_knee" ctrlrange="-1.45 0.1"/>
    <position name="left_ankle" joint="left_ankle" ctrlrange="-0.19 1.4"/>
    <position name="left_ankle_roll" joint="left_ankle_roll" ctrlrange="-0.5 0.5"/>
    <position name="right_hip_yaw" joint="right_hip_yaw" ctrlrange="-0.35 0.35"/>
    <position name="right_hip_roll" joint="right_hip_roll" ctrlrange="-0.5 0.5"/>
    <position name="right_hip_pitch" joint="right_hip_pitch" ctrlrange="-0.29 1.29"/>
    <position name="right_knee" joint="right_knee" ctrlrange="-1.45 0.1"/>
    <position name="right_ankle" joint="right_ankle" ctrlrange="-0.19 1.4"/>
    <position name="right_ankle_roll" joint="right_ankle_roll" ctrlrange="-0.5 0.5"/>
    <position name="neck_pitch" joint="neck_pitch" class="micro" ctrlrange="-0.8 0.8"/>
    <position name="head_pitch" joint="head_pitch" class="micro" ctrlrange="-0.9 0.9"/>
    <position name="head_yaw" joint="head_yaw" class="micro" ctrlrange="-1.3 1.3"/>
    <position name="head_roll" joint="head_roll" class="micro" ctrlrange="-0.5 0.5"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
    <touch name="left_toe_touch" site="left_toe_touch"/>
    <touch name="left_heel_touch" site="left_heel_touch"/>
    <touch name="right_toe_touch" site="right_toe_touch"/>
    <touch name="right_heel_touch" site="right_heel_touch"/>
    <rangefinder name="tof" site="tof"/>
  </sensor>

  <keyframe>
    <!-- De pie, rodillas flexionadas (calculado con la cinemática inversa de sim/gait.py) -->
    <key name="home" qpos="0 0 0.1210 1 0 0 0 -0 0 0.942963 -1.15376 0.2108 -0 0 0 0.942963 -1.15376 0.2108 -0 0 0 0 0" ctrl="-0 0 0.942963 -1.15376 0.2108 -0 0 0 0.942963 -1.15376 0.2108 -0 0 0 0 0"/>
  </keyframe>
</mujoco>
