<!--
  Mini16: bípedo pequeño de ~24 cm con 16 motores, con proporciones similares al Microduck:
  piernas cortas con rodilla hacia atrás, tobillo de dos ejes, torso compacto, cuello muy
  corto y cabeza con cámara USB.

  Componentes: 12x STS3215 (piernas), 4x SCS0009 (cabeza), Orange Pi Zero 3, cámara USB,
  2x 18650 alta descarga + BMS 2S, IMU BNO055, ToF VL53L5CX/VL53L8CX, 4x SS-10 (pisada).

  Motores:
    Cada pierna (6):  cadera yaw, cadera roll, cadera pitch, rodilla, tobillo pitch, tobillo roll
    Cuello/cabeza (4): cuello pitch, cabeza pitch, cabeza yaw, cabeza roll

  El tobillo roll (lateral) mantiene el pie plano cuando el cuerpo se carga sobre una
  pierna; con él puede levantar el pie 2-2.5 cm y subir rampas de 10-15° (ver README).

  Piernas: Feetech STS3215 7.4 V (con lectura de posición).
  Cabeza:  micro servos de bus con lectura de posición (p. ej. Feetech SCS0009).

  Ejes: x = adelante, y = izquierda, z = arriba. Unidades: m, kg, rad.
  Origen del torso = punto medio entre los ejes de cadera pitch.
  Pierna: yaw (z +0.030) -> roll (+0.012) -> pitch (0) -> muslo 4 cm -> rodilla
          -> canilla 4.5 cm -> tobillo pitch + roll (ejes cruzados) -> suela (2 cm más abajo).
-->
<mujoco model="mini16">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <geom contype="2" conaffinity="1" friction="0.9 0.02 0.01" condim="3"/>
    <joint damping="0.08" armature="0.01" frictionloss="0.03"/>
    <!-- STS3215 7.4 V: ~1.9 N·m máx. Ganancias estimadas (identificar con servo real). -->
    <position kp="10" kv="0.15" forcerange="-1.9 1.9"/>

    <default class="micro">
      <!-- Micro servo de cabeza: ~0.2 N·m. Valores estimados. -->
      <joint damping="0.01" armature="0.001" frictionloss="0.005"/>
      <position kp="1.5" kv="0.02" forcerange="-0.22 0.22"/>
    </default>

    <default class="servo">
      <!-- STS3215: 45 x 35 x 25 mm, 55 g -->
      <geom type="box" mass="0.055" rgba="0.1 0.1 0.11 1"/>
    </default>
    <default class="micro_servo">
      <!-- Feetech SCS0009: 23.2 x 12.1 x 25.25 mm, ~12 g, 2.3 kg·cm a 6 V -->
      <geom type="box" size="0.012 0.011 0.006" mass="0.012" rgba="0.1 0.1 0.11 1"/>
    </default>
    <default class="hub">
      <!-- Disco visual que marca cada articulación de pitch (eje en y). -->
      <geom type="cylinder" size="0.008 0.02" zaxis="0 1 0" contype="0" conaffinity="0" density="0"
            rgba="0.75 0.75 0.78 1"/>
    </default>
    <default class="shell">
      <geom type="box" contype="0" conaffinity="0" density="0" rgba="0.55 0.82 0.9 1"/>
    </default>
    <default class="sole">
      <geom type="box" size="0.04 0.022 0.004" pos="0.008 0 -0.016" mass="0.03" rgba="0.98 0.6 0.15 1"
            friction="1.0 0.02 0.01"/>
    </default>
  </default>

  <worldbody>
    <body name="torso" pos="0 0 0.0855">
      <freejoint name="root"/>
      <!-- IMU BNO055 fija y nivelada entre los servos de cadera, cerca del centro de masa -->
      <site name="imu" pos="0 0 0.035" size="0.005"/>
      <geom name="imu_board" type="box" pos="0 0 0.033" size="0.0105 0.013 0.001" mass="0.003" contype="0" conaffinity="0" rgba="0.1 0.3 0.6 1"/>

      <!-- Torso 70 x 80 x 62 mm. Distribución (de abajo hacia arriba):
           servos de cadera yaw -> batería 2x18650 (arriba de ellos) -> Orange Pi Zero 3.
           Atrás: adaptador de bus de servos, UBEC 5 V, regulador 6 V (cabeza), BMS 2S, condensador. -->
      <geom name="torso" type="box" pos="0 0 0.057" size="0.035 0.04 0.031" mass="0.055" rgba="0.55 0.82 0.9 1"/>
      <geom name="battery" type="box" pos="0 0 0.0555" size="0.0185 0.0325 0.0095" mass="0.098"
            contype="0" conaffinity="0" rgba="0.2 0.3 0.6 1"/>
      <geom name="orange_pi" type="box" pos="0 0 0.0735" size="0.025 0.0275 0.006" mass="0.025"
            contype="0" conaffinity="0" rgba="0.95 0.5 0.1 1"/>
      <geom name="power_and_bus" type="box" pos="-0.028 0 0.06" size="0.005 0.035 0.02" mass="0.05"
            contype="0" conaffinity="0" rgba="0.1 0.5 0.2 1"/>
      <!-- Sensor de distancia ToF 8x8 (VL53L5CX / VL53L8CX) al frente, mirando hacia el piso delante -->
      <geom name="tof_sensor" type="box" pos="0.0355 0 0.035" size="0.001 0.0065 0.01" mass="0.002"
            contype="0" conaffinity="0" rgba="0.1 0.1 0.1 1"/>
      <site name="tof" pos="0.037 0 0.035" zaxis="0.7 0 -0.7" size="0.003"/>
      <!-- Servos de cadera yaw (eje vertical), dentro del torso. -->
      <geom name="left_hip_yaw_servo" class="servo" pos="0 0.03 0.028" size="0.0226 0.0124 0.0175"/>
      <geom name="right_hip_yaw_servo" class="servo" pos="0 -0.03 0.028" size="0.0226 0.0124 0.0175"/>

      <!-- ============================ PIERNA IZQUIERDA ============================ -->
      <body name="left_hip_yaw_link" pos="0 0.033 0.03">
        <joint name="left_hip_yaw" axis="0 0 1" range="-0.6 0.6"/>
        <geom name="left_hip_bracket" type="box" pos="0 0 -0.006" size="0.014 0.012 0.003" mass="0.008" rgba="0.75 0.75 0.78 1"/>
        <body name="left_hip_roll_link" pos="0 0 -0.018">
          <joint name="left_hip_roll" axis="1 0 0" range="-0.5 0.5"/>
          <geom name="left_hip_roll_servo" class="servo" pos="0 0 0.004" size="0.0226 0.0124 0.009" mass="0.055"/>
          <body name="left_thigh" pos="0 0 -0.012">
            <joint name="left_hip_pitch" axis="0 1 0" range="-1.0 1.6"/>
            <geom class="hub"/>
            <geom name="left_hip_pitch_servo" class="servo" pos="0 0.004 0" size="0.0124 0.0175 0.012"/>
            <!-- Muslo: el servo de la rodilla va acostado dentro de la placa. -->
            <geom name="left_knee_servo" class="servo" pos="0 0 -0.022" size="0.0124 0.0175 0.018"/>
            <geom class="shell" pos="0 0.021 -0.02" size="0.016 0.003 0.024"/>
            <body name="left_shin" pos="0 0 -0.04">
              <joint name="left_knee" axis="0 1 0" range="-2.4 0.1"/>
              <geom class="hub"/>
              <geom name="left_shin" type="capsule" fromto="0 0 0 0 0 -0.045" size="0.007" mass="0.015"
                    rgba="0.75 0.75 0.78 1"/>
              <geom name="left_ankle_servo" class="servo" pos="0 0 -0.03" size="0.0124 0.0175 0.012"/>
              <body name="left_foot" pos="0 0 -0.045">
                <joint name="left_ankle" axis="0 1 0" range="-1.4 1.4"/>
                <!-- Tobillo roll: mantiene el pie plano hacia los lados (eje cruzado con el pitch). -->
                <joint name="left_ankle_roll" axis="1 0 0" range="-0.5 0.5"/>
                <geom name="left_ankle_roll_servo" class="servo" pos="0 0 -0.006" size="0.0226 0.0124 0.009" contype="0" conaffinity="0"/>
                <geom class="hub" size="0.007 0.016"/>
                <geom name="left_sole" class="sole"/>
                <!-- Sensores de pisada: microinterruptor SS-10 en punta y talón -->
                <site name="left_toe_touch" type="box" pos="0.032 0 -0.019" size="0.016 0.022 0.004" rgba="0 0 0 0"/>
                <site name="left_heel_touch" type="box" pos="-0.016 0 -0.019" size="0.016 0.022 0.004" rgba="0 0 0 0"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============================ PIERNA DERECHA ============================= -->
      <body name="right_hip_yaw_link" pos="0 -0.033 0.03">
        <joint name="right_hip_yaw" axis="0 0 1" range="-0.6 0.6"/>
        <geom name="right_hip_bracket" type="box" pos="0 0 -0.006" size="0.014 0.012 0.003" mass="0.008" rgba="0.75 0.75 0.78 1"/>
        <body name="right_hip_roll_link" pos="0 0 -0.018">
          <joint name="right_hip_roll" axis="1 0 0" range="-0.5 0.5"/>
          <geom name="right_hip_roll_servo" class="servo" pos="0 0 0.004" size="0.0226 0.0124 0.009" mass="0.055"/>
          <body name="right_thigh" pos="0 0 -0.012">
            <joint name="right_hip_pitch" axis="0 1 0" range="-1.0 1.6"/>
            <geom class="hub"/>
            <geom name="right_hip_pitch_servo" class="servo" pos="0 -0.004 0" size="0.0124 0.0175 0.012"/>
            <geom name="right_knee_servo" class="servo" pos="0 0 -0.022" size="0.0124 0.0175 0.018"/>
            <geom class="shell" pos="0 -0.021 -0.02" size="0.016 0.003 0.024"/>
            <body name="right_shin" pos="0 0 -0.04">
              <joint name="right_knee" axis="0 1 0" range="-2.4 0.1"/>
              <geom class="hub"/>
              <geom name="right_shin" type="capsule" fromto="0 0 0 0 0 -0.045" size="0.007" mass="0.015"
                    rgba="0.75 0.75 0.78 1"/>
              <geom name="right_ankle_servo" class="servo" pos="0 0 -0.03" size="0.0124 0.0175 0.012"/>
              <body name="right_foot" pos="0 0 -0.045">
                <joint name="right_ankle" axis="0 1 0" range="-1.4 1.4"/>
                <!-- Tobillo roll: mantiene el pie plano hacia los lados (eje cruzado con el pitch). -->
                <joint name="right_ankle_roll" axis="1 0 0" range="-0.5 0.5"/>
                <geom name="right_ankle_roll_servo" class="servo" pos="0 0 -0.006" size="0.0226 0.0124 0.009" contype="0" conaffinity="0"/>
                <geom class="hub" size="0.007 0.016"/>
                <geom name="right_sole" class="sole"/>
                <!-- Sensores de pisada: microinterruptor SS-10 en punta y talón -->
                <site name="right_toe_touch" type="box" pos="0.032 0 -0.019" size="0.016 0.022 0.004" rgba="0 0 0 0"/>
                <site name="right_heel_touch" type="box" pos="-0.016 0 -0.019" size="0.016 0.022 0.004" rgba="0 0 0 0"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ============================ CUELLO Y CABEZA ============================ -->
      <body name="neck" pos="0 0 0.088" childclass="micro">
        <joint name="neck_pitch" axis="0 1 0" range="-0.8 0.8"/>
        <geom class="micro_servo"/>
        <!-- Cuello muy corto (0.8 cm): prácticamente los servos apilados -->
        <geom name="neck" type="box" pos="0 0 0.004" size="0.009 0.012 0.004" mass="0.003" rgba="0.1 0.1 0.11 1"/>
        <body name="head_pitch_link" pos="0 0 0.008">
          <joint name="head_pitch" axis="0 1 0" range="-0.9 0.9"/>
          <geom class="micro_servo"/>
          <body name="head_yaw_link" pos="0 0 0.008">
            <joint name="head_yaw" axis="0 0 1" range="-1.3 1.3"/>
            <geom class="micro_servo" size="0.011 0.011 0.004"/>
            <body name="head" pos="0 0 0.008">
              <joint name="head_roll" axis="1 0 0" range="-0.5 0.5"/>
              <geom class="micro_servo" size="0.011 0.006 0.006"/>
              <!-- Cabeza: carcasa -->
              <geom name="head" type="box" pos="0.02 0 0.024" size="0.042 0.032 0.02" mass="0.04"
                    rgba="0.55 0.82 0.9 1"/>
              <!-- Cámara USB (UVC) compacta, placa 32 x 32 mm, ~6 g, al frente de la cabeza.
                   Campo de visión ~70° horizontal (~55° vertical en 4:3). -->
              <geom name="camera_board" type="box" pos="0.0635 0 0.024" size="0.0015 0.016 0.016" mass="0.005"
                    contype="0" conaffinity="0" rgba="0.1 0.35 0.15 1"/>
              <geom name="camera_lens_mount" type="box" pos="0.0665 0 0.026" size="0.0015 0.0055 0.0055" mass="0.001"
                    contype="0" conaffinity="0" rgba="0.08 0.08 0.08 1"/>
              <geom name="camera_lens" type="cylinder" pos="0.069 0 0.026" zaxis="1 0 0" size="0.0038 0.001"
                    contype="0" conaffinity="0" density="0" rgba="0.15 0.2 0.5 1"/>
              <camera name="eye" pos="0.0705 0 0.026" xyaxes="0 -1 0 0 0 1" fovy="55"/>
              <site name="camera" pos="0.0705 0 0.026" size="0.003"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_hip_yaw" joint="left_hip_yaw" ctrlrange="-0.6 0.6"/>
    <position name="left_hip_roll" joint="left_hip_roll" ctrlrange="-0.5 0.5"/>
    <position name="left_hip_pitch" joint="left_hip_pitch" ctrlrange="-1.0 1.6"/>
    <position name="left_knee" joint="left_knee" ctrlrange="-2.4 0.1"/>
    <position name="left_ankle" joint="left_ankle" ctrlrange="-1.4 1.4"/>
    <position name="left_ankle_roll" joint="left_ankle_roll" ctrlrange="-0.5 0.5"/>
    <position name="right_hip_yaw" joint="right_hip_yaw" ctrlrange="-0.6 0.6"/>
    <position name="right_hip_roll" joint="right_hip_roll" ctrlrange="-0.5 0.5"/>
    <position name="right_hip_pitch" joint="right_hip_pitch" ctrlrange="-1.0 1.6"/>
    <position name="right_knee" joint="right_knee" ctrlrange="-2.4 0.1"/>
    <position name="right_ankle" joint="right_ankle" ctrlrange="-1.4 1.4"/>
    <position name="right_ankle_roll" joint="right_ankle_roll" ctrlrange="-0.5 0.5"/>
    <position name="neck_pitch" joint="neck_pitch" class="micro" ctrlrange="-0.8 0.8"/>
    <position name="head_pitch" joint="head_pitch" class="micro" ctrlrange="-0.9 0.9"/>
    <position name="head_yaw" joint="head_yaw" class="micro" ctrlrange="-1.3 1.3"/>
    <position name="head_roll" joint="head_roll" class="micro" ctrlrange="-0.5 0.5"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_accel" site="imu"/>
    <touch name="left_toe_touch" site="left_toe_touch"/>
    <touch name="left_heel_touch" site="left_heel_touch"/>
    <touch name="right_toe_touch" site="right_toe_touch"/>
    <touch name="right_heel_touch" site="right_heel_touch"/>
    <rangefinder name="tof" site="tof"/>
  </sensor>

  <keyframe>
    <!-- De pie, rodillas flexionadas hacia atrás (cadera a 8.5 cm de la suela). -->
    <key name="home"
         qpos="0 0 0.0855 1 0 0 0
               0 0 0.751 -1.403 0.652 0
               0 0 0.751 -1.403 0.652 0
               0 0 0 0"
         ctrl="0 0 0.751 -1.403 0.652 0
               0 0 0.751 -1.403 0.652 0
               0 0 0 0"/>
  </keyframe>
</mujoco>
